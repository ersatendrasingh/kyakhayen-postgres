# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Local Docker example:
# docker run --name kyakhayen-postgresql -e POSTGRES_DB=kyakhayen_dev -e POSTGRES_USER=kyakhayen -e POSTGRES_PASSWORD=kyakhayen_dev_pw -p 5433:5432 -d postgres:16
# Use the provider's pooled URL at runtime and its direct URL for migrations/backups.
DATABASE_URL="postgresql://kyakhayen:kyakhayen_dev_pw@127.0.0.1:5433/kyakhayen_dev"
DIRECT_URL="postgresql://kyakhayen:kyakhayen_dev_pw@127.0.0.1:5433/kyakhayen_dev"

# Authentication (Auth.js)
AUTH_SECRET=
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
EMAIL_FROM_NAME="Kya Khayen"
EMAIL_FROM_ADDRESS=
ADMIN_EMAIL=

# Media storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_MEDIA_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=

# Media storage (Cloudinary primary; credentials can also be saved in Admin > Site Settings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Required to encrypt Cloudinary API secrets saved from Site Settings.
# SOCIAL_TOKEN_ENCRYPTION_KEY is used as a fallback during migration.
SITE_SETTINGS_ENCRYPTION_KEY=
# CloudFront/custom CDN domain backed only by the media bucket
NEXT_PUBLIC_MEDIA_URL=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY=

# Background queues
REDIS_URL=
REDIS_SERVER_HOST=127.0.0.1
REDIS_SERVER_PORT=6379
REDIS_SERVER_PASSWORD=
REDIS_SERVER_TLS=false
MEAL_PLAN_WORKER_SECRET=
CRON_SECRET=
INTERNAL_APP_URL=http://127.0.0.1:3002
VERCEL_WORKER_CRON_TIMEOUT_MS=240000
VERCEL_WORKER_CONCURRENCY=1

# Database backups
DB_BACKUP_DIR=/opt/kasa/backups/kyakhayen-db
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_S3_BUCKET=
DB_BACKUP_S3_PREFIX=kyakhayen/postgresql
DB_BACKUP_S3_REQUIRED=false

# Currency conversion
NEXT_PUBLIC_EXCHANGE_API_URL=
NEXT_PUBLIC_FREE_CURRENCY_API_KEY=

# Analytics
NEXT_PUBLIC_GTM_ID=GTM-N99FLD9B

# AI content pipeline
CARTESIA_API_KEY=
CARTESIA_DEFAULT_VOICE_ID=faf0731e-dfb9-4cfc-8119-259a79b27e12

# Free social publishing APIs (dry_run keeps the system safe while testing)
SOCIAL_PUBLISH_MODE=dry_run

# Meta: Facebook Page + Instagram professional account.
# Use long-lived Page/System User tokens for production, not Graph API Explorer session tokens.
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_INSTAGRAM_USER_ID=
META_FACEBOOK_PAGE_ID=

# YouTube Shorts: Google OAuth refresh token + rendered MP4 upload worker.
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
YOUTUBE_UPLOAD_PRIVACY_STATUS=unlisted

# X: OAuth 1.0a user-context tokens. X API is paid; keep disabled until credits are ready.
X_PUBLISH_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# LinkedIn: author urn examples: urn:li:person:xxxx or urn:li:organization:123.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_AUTHOR_URN=

# Pinterest: use the in-app OAuth connect flow, not 24-hour generated test tokens.
# Trial-access apps can test Pin creation only against api-sandbox.pinterest.com.
# Real production Pins on kyakhayen.com require Pinterest Standard access.
# Register this exact callback in Pinterest Developer Portal:
# https://your-domain.com/api/admin/content-pipeline/pinterest/oauth/callback
# Required OAuth scopes: boards:read, boards:write, pins:read, pins:write
PINTEREST_PUBLISH_ENABLED=false
PINTEREST_API_ENV=production
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://www.kyakhayen.com/api/admin/content-pipeline/pinterest/oauth/callback
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Access/refresh tokens and the selected board are saved encrypted in the database by OAuth.

# Web push notifications (generate one VAPID key pair and keep the private key server-only)
VAPID_SUBJECT=mailto:support@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
